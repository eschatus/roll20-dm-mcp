# roll20-dm-mcp — environment. Every variable here is actually read by the source;
# nothing is aspirational. All are optional unless noted.

# --- Data directory -----------------------------------------------------------
# Where the campaign registry and the FURNISHED credentials live. This server reads
# roll20-rt-token.json and roll20-upload-cache.json from here and never harvests
# either — DM Whisper writes them. Point this at the SAME directory the gem uses
# (Windows: %APPDATA%\DM Whisper) or the two silently diverge.
# ROLL20_DATA_DIR=./data

# --- HTTP server (roll20-dm) --------------------------------------------------
# Bearer token for the HTTP MCP endpoint. Generated into .env on first run if absent.
# ROLL20_MCP_TOKEN=
# ROLL20_HTTP_PORT=39200
# ROLL20_HTTP_HOST=127.0.0.1

# --- Campaign fallback --------------------------------------------------------
# Used only to synthesize an active campaign when the registry has none. BOTH are
# required for that fallback to work. DDB_CAMPAIGN_ID is a linkage id passed to a
# D&D Beyond lookup server (beyond-mcp) — nothing in this repo reads D&D Beyond.
# ROLL20_CAMPAIGN_ID=
# DDB_CAMPAIGN_ID=

# --- Maps suite ---------------------------------------------------------------
# Needed ONLY by analyze_battlemap (Claude Vision wall detection) in roll20-dm-maps.
# The combat server makes no model calls and needs no key.
# ANTHROPIC_API_KEY=
# Root directory battlemap tools are confined to.
# ROLL20_ASSET_DIR=

# --- Diagnostics --------------------------------------------------------------
# RT_DEBUG=1                 # log every RTDB chat child as it arrives
# SANDBOX_WATCHDOG_MS=300000 # Mod sandbox liveness ping interval
